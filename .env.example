NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Firebase Web SDK config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=xtech-automation.firebaseapp.com
FIREBASE_PROJECT_ID=xtech-automation
FIREBASE_STORAGE_BUCKET=xtech-automation.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional production override for Firebase Admin service-account file.
# Render Secret Files are available under /etc/secrets/.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Google Gemini AI
GEMINI_API_KEY=

# Optional admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Email OTP delivery through Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="XTECH Automation <no-reply@xtech-automation.com>"
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
